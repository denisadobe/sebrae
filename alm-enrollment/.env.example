# Copy to .env (never commit .env) and fill in. `aio app use` adds the AIO_* values.

# Adobe Learning Manager — Integration Admin, Applications, Register
# scopes: admin:read, admin:write, learner:read, learner:write
ALM_BASE_URL=https://learningmanager.adobe.com
ALM_CLIENT_ID=
ALM_CLIENT_SECRET=
# one of the application's Redirect Domains (used by `npm run refresh-token`)
ALM_REDIRECT_URI=https://main--sebrae--denisadobe.aem.page/
# filled by `npm run refresh-token` (ALM administrator authorization)
ALM_REFRESH_TOKEN=
# external profile for public customers (Users, External); empty = internal users
ALM_EXTERNAL_PROFILE_ID=
# Commerce product attribute with the ALM course id (e.g. 123 or course:123)
ALM_COURSE_ATTRIBUTE=alm_course_id
ALM_LOCALE=pt-BR
# optional: ALM account id for course links (default: from the admin token)
ALM_ACCOUNT_ID=115171

# Adobe Commerce as a Cloud Service
COMMERCE_GRAPHQL_URL=https://na1-sandbox.api.commerce.adobe.com/TcvPqpzQp1aRq3ohMQt2ct/graphql
COMMERCE_WEBSITE_CODE=base
COMMERCE_STORE_CODE=main_website_store
COMMERCE_STORE_VIEW_CODE=default

# Single sign-on (Auth0 / OIDC) — sso-login action
SSO_DOMAIN=dev-533cjwwlbzw8n64k.us.auth0.com
# Client ID of the "Sebrae Site" Single Page Application (public)
SSO_CLIENT_ID=y6NYpJRQo0gYkxaxSI7da0YuRRj2d0PJ
# Commerce admin calls (exchangeExternalCustomerToken): OAuth Server-to-Server credential with
# the "Adobe Commerce as a Cloud Service" API. Empty = taken from workspace.json.
IMS_CLIENT_ID=
IMS_CLIENT_SECRET=
IMS_ORG_ID=

# I/O Events: Commerce event provider of the workspace (aio event provider list)
AIO_events_providermetadata_to_provider_mapping=dx_commerce_events:PROVIDER_ID
