{
  "definitions": [
    {
      "title": "Formulário",
      "id": "form",
      "model": "form",
      "filter": "form",
      "plugins": {
        "da": {
          "name": "form",
          "rows": 1,
          "columns": 6
        }
      }
    },
    {
      "title": "Campo do formulário",
      "id": "form-field",
      "model": "form-field",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 6,
          "fields": [
            { "name": "type", "selector": "div:nth-child(1)" },
            { "name": "label", "selector": "div:nth-child(2)" },
            { "name": "name", "selector": "div:nth-child(3)" },
            { "name": "placeholder", "selector": "div:nth-child(4)" },
            { "name": "options", "selector": "div:nth-child(5)" },
            { "name": "required", "selector": "div:nth-child(6)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "form-field",
      "fields": [
        {
          "component": "select",
          "name": "type",
          "label": "Tipo de campo",
          "valueType": "string",
          "value": "text",
          "options": [
            { "name": "Texto", "value": "text" },
            { "name": "E-mail", "value": "email" },
            { "name": "Telefone", "value": "tel" },
            { "name": "Texto longo", "value": "textarea" },
            { "name": "Lista de seleção", "value": "select" },
            { "name": "Múltipla escolha (lista)", "value": "multiselect" },
            { "name": "Opções (radio)", "value": "radio" },
            { "name": "Caixa de seleção (aceite)", "value": "checkbox" },
            { "name": "Título", "value": "heading" },
            { "name": "Botão de envio", "value": "submit" }
          ]
        },
        { "component": "text", "name": "label", "label": "Rótulo", "valueType": "string" },
        { "component": "text", "name": "name", "label": "Nome técnico do campo", "valueType": "string" },
        { "component": "text", "name": "placeholder", "label": "Placeholder (no botão: mensagem de confirmação)", "valueType": "string" },
        { "component": "text", "name": "options", "label": "Opções (separadas por vírgula)", "valueType": "string" },
        {
          "component": "select",
          "name": "required",
          "label": "Obrigatório",
          "valueType": "string",
          "value": "",
          "options": [
            { "name": "Não", "value": "" },
            { "name": "Sim", "value": "sim" }
          ]
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "form",
      "components": ["form-field"]
    }
  ]
}
